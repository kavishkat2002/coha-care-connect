# Coha Care Connect — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Your Supabase project URL (found in: Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Your Supabase anonymous/public key
# (found in: Project Settings → API → Project API keys → anon public)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Groq AI ──────────────────────────────────────────────────────────────────
# Your Groq API key for all AI inference features (symptom analysis, image
# analysis, report analysis, voice care, and Whisper transcription).
# Get your key at: https://console.groq.com/keys
VITE_GROQ_API_KEY=gsk_your-groq-api-key-here
